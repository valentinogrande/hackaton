# Copy to .env.local and fill in values.
# DO NOT commit .env.local (it's already in .gitignore).

# Supabase — values for this project's Supabase instance.
# The publishable key is safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://mmcahdqmjwftuygjexsz.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_L45LSTFZWWuOvJesOC8J0w_ZuD3ScQD

# Server-only — pedí esta key al admin del proyecto en el chat del equipo.
# Supabase dashboard > Project Settings > API > service_role
SUPABASE_SERVICE_ROLE_KEY=

# Dev C — https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# ────────────────────────────────────────────────────────────
# Finance module
# ────────────────────────────────────────────────────────────

# Yield oracle: 'configured_apy' (default, MVP) or 'live_nav' (broker API, TODO).
FINANCE_YIELD_ORACLE=configured_apy
FINANCE_DEFAULT_APY=0.043
FINANCE_FEE_RATE=0.015
FINANCE_FX_ARS_PER_USD=1300

# Payment gateway: 'mock' (default) or 'mercadopago' (once MP MCP is installed).
FINANCE_PAYMENT_GATEWAY=mock

# Cron: shared secret required in the `x-cron-secret` header on /api/finance/cron/*
CRON_SECRET=

# MercadoPago — only required when FINANCE_PAYMENT_GATEWAY=mercadopago.
# Use test credentials from https://www.mercadopago.com.ar/developers/panel/credentials
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
